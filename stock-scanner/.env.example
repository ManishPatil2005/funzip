# Copy to .env and fill in. Never commit .env.
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Several keys may be listed (comma-separated) to allow rotation; each must be >= 32 chars.
SCANNER_API_KEYS=change-me-generate-a-long-random-key-here
SCANNER_DOMAIN=scanner.example.com

# Optional tuning
SCANNER_CACHE_TTL=300
SCANNER_RATE_LIMIT=60
SCANNER_SCAN_RATE_LIMIT=10
SCANNER_MAX_SCAN_SYMBOLS=60
SCANNER_SCAN_WORKERS=8
SCANNER_LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API from another site (leave empty for same-origin only)
SCANNER_CORS_ORIGINS=
