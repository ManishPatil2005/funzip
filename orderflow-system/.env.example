# Copy to .env and fill in LOCALLY. Never commit .env, never paste these values into chat.
OFX_API_KEY=change-me-long-random-string
OFX_CORS_ORIGINS=http://localhost:5173
OFX_RATE_PER_MIN=120
OFX_TRUST_PROXY=0
# Optional live ingest on startup
# OFX_LIVE_IID=SYN:TEST
# OFX_LIVE_TICK=0.5
# OFX_LIVE_TF=1m
# Database
POSTGRES_PASSWORD=change-me
OFX_DATABASE_URL=postgresql://ofx:change-me@db:5432/ofx
# Angel One (stocks) - names only here; values go in your private .env
ANGEL_SMARTAPI_KEY=
ANGEL_CLIENT_ID=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
# Delta Exchange (later phase)
DELTA_EXCHANGE_API_KEY=
DELTA_EXCHANGE_SECRET=
